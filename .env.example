PORT=3000

# Direktori penyimpanan SQLite (finance.db) & sesi login WhatsApp (wa-auth)
# Saat deploy di Railway / Render / Fly.io, arahkan ke mount path Persistent Volume (misal: /data)
DATA_DIR=./data

# Saldo Awal 3 Dompet (Otomatis dipakai saat database pertama kali dibuat)
INITIAL_CASH_BALANCE=420000
INITIAL_ATM_BALANCE=8300000
INITIAL_ATM2_BALANCE=4182000

# Konfigurasi Google Spreadsheet & Apps Script Webhook (Database Cloud Permanen)
SPREADSHEET_ID=1_UvnRmnVZzxfzNp-mASlWtrpuqShcDD8ei8NuHK3YkM
APPS_SCRIPT_WEBHOOK_URL=

# Konfigurasi AI (OpenRouter / Groq)
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=qwen/qwen3.8-27b:free
AI_API_KEY=

# Keamanan Bot WhatsApp (Hanya merespons nomor di bawah ini & 100% Anti-Grup)
